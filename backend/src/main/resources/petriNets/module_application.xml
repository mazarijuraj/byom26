<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://petriflow.com/petriflow.schema.xsd">
	<id>module_application</id>
	<version>1.0.0</version>
	<initials>MAP</initials>
	<title>Module Application</title>
	<icon>device_hub</icon>
	<defaultRole>false</defaultRole>
	<anonymousRole>false</anonymousRole>
	<transitionRole>false</transitionRole>
	<data type="button">
		<id>add_achievement</id>
		<title/>
		<placeholder>add</placeholder>
		<event type="set">
			<id>add_achievement_set</id>
			<actions phase="post">
				<action id="7">
					<![CDATA[
					achievement_cases: f.achievement_cases,
					achievement_tasks: f.achievement_tasks;

					def achievementCase = createCase("achievement")
					def initTask = assignTask("init", achievementCase)
					setData(initTask, [
							"parent": [
									"value": [useCase.stringId],
									"type": "caseRef"
							]
					])
					finishTask(initTask)
					change achievement_tasks value { achievement_tasks.value << getTaskId("form", achievementCase) }
					change achievement_cases value { achievement_cases.value << achievementCase.stringId }
					]]>
				</action>
			</actions>
		</event>
	</data>
	<data type="text">
		<id>rejection_reason</id>
		<title>Reason for rejection</title>
		<component>
			<name>htmltextarea</name>
		</component>
	</data>
	<data type="enumeration_map">
		<id>decision</id>
		<title>Decision</title>
		<options>
			<option key="ok">Recognized</option>
			<option key="ko">Not Recognized</option>
		</options>
		<event type="set">
			<id>decision_set</id>
			<actions phase="post">
				<action id="12">
					<![CDATA[
					decision: f.decision,
					print: t.print,
					rejection_reason: f.rejection_reason;

					make rejection_reason, visible on print when { decision.value == "ko" }
					]]>
				</action>
			</actions>
		</event>
	</data>
	<data type="enumeration_map">
		<id>decision_exam_office</id>
		<title>Decision</title>
		<options>
			<option key="ok">Approve recognition</option>
			<option key="ko">Reject recognition</option>
		</options>
	</data>
	<data type="enumeration_map">
		<id>responsible_person</id>
		<title>Person Responsible</title>
		<options>
			<option key="exam">Decision by Examination Office</option>
			<option key="owner">Decision by Subject Representative</option>
		</options>
	</data>
	<data type="text">
		<id>header</id>
		<title>Module Description</title>
	</data>
	<data type="taskRef">
		<id>achievement_tasks</id>
		<title/>
		<event type="set">
			<id>achievement_tasks_set</id>
			<actions phase="post">
				<action id="4">
					<![CDATA[
					achievement_tasks: f.achievement_tasks,
					parent: f.parent;
					if (achievement_tasks.value.size() > 0) {
						return;
					}
					def applicationCase = findCase(parent)
					def formTaskId = getTaskId("register")
					setData("modules_submit", applicationCase, [
							"module_applications_tasks": [
									"value": applicationCase.dataSet["module_applications_tasks"].value - formTaskId,
									"type": "taskRef"
							],
							"module_applications_cases": [
									"value": applicationCase.dataSet["module_applications_cases"].value - useCase.stringId,
									"type": "caseRef"
							]
					]);
					]]>
				</action>
			</actions>
		</event>
	</data>
	<data type="caseRef">
		<id>achievement_cases</id>
		<title/>
		<allowedNets>
			<allowedNet>achievement</allowedNet>
		</allowedNets>
	</data>
	<data type="taskRef">
		<id>achievement_tasks_owner</id>
		<title/>
	</data>
	<data type="taskRef">
		<id>achievement_tasks_examiner</id>
		<title/>
	</data>
	<data type="caseRef">
		<id>modul</id>
		<title/>
		<event type="set">
			<id>modul_set</id>
			<actions phase="post">
				<action id="1">
					<![CDATA[
					title_print: f.title_print,
					header: f.header,
					module: f.modul;

					def modulCase = findCase(module)
					change header value {
						"You wish to have the <b>" + modulCase.dataSet["number"].value + " - " + modulCase.dataSet["name"].value + " (" + modulCase.dataSet["ects"].value.intValue() + " ECTS) module from the FernUniversität recognized. You can check the module <a href=\"${modulCase.dataSet["website"].value}\" target=\"_blank\">description</a>. Then, enter the coursework you have completed that you wish to use for this recognition."
					}
					change title_print value { "<b>" + modulCase.dataSet["number"].value + " - " + modulCase.dataSet["name"].value + " (" + modulCase.dataSet["ects"].value.intValue() + " ECTS)</b>" }
					]]>
				</action>
			</actions>
		</event>
		<allowedNets>
			<allowedNet>module</allowedNet>
		</allowedNets>
	</data>
	<data type="caseRef">
		<id>parent</id>
		<title/>
		<allowedNets>
			<allowedNet>application</allowedNet>
		</allowedNets>
	</data>
	<data type="i18n">
		<id>title</id>
		<title/>
		<init>##### - Name - ECTS</init>
	</data>
	<data type="text">
		<id>title_print</id>
		<title/>
		<init>##### - Modul (# ECTS)</init>
		<component>
			<name>htmltextarea</name>
		</component>
	</data>
	<transition>
		<id>register</id>
		<x>720</x>
		<y>176</y>
		<label>Enter data</label>
		<dataGroup>
			<id>t2_0</id>
			<cols>9</cols>
			<layout>grid</layout>
			<dataRef>
				<id>header</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>9</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<component>
					<name>htmltextarea</name>
				</component>
			</dataRef>
			<dataRef>
				<id>achievement_tasks</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>9</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>add_achievement</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>8</x>
					<y>2</y>
					<rows>1</rows>
					<cols>1</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<component>
					<name>minifab</name>
				</component>
			</dataRef>
			<dataRef>
				<id>achievement_cases</id>
				<logic>
					<behavior>forbidden</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>6</y>
					<rows>1</rows>
					<cols>9</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>register_finish</id>
			<actions phase="post">
				<action id="3">
					<![CDATA[
					achievement_tasks_examiner: f.achievement_tasks_examiner,
					achievement_cases: f.achievement_cases,
					achievement_tasks: f.achievement_tasks;

					if (achievement_tasks.value.size() == 0) {
						return
					}
					def achievementTasks = findTasks(achievement_tasks)
					assignTasks(achievementTasks)
					finishTasks(achievementTasks)

					def leistungenPATasks = searchTasks("tasks: transitionId == 'review' and caseId in ${pfql(achievement_cases)}")
					change achievement_tasks_examiner value { leistungenPATasks.collect { it.stringId} }
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>decide</id>
		<x>1008</x>
		<y>208</y>
		<label>Decide module application</label>
		<dataGroup>
			<id>t3_0</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>title_print</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>5</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>decision_exam_office</id>
				<logic>
					<behavior>editable</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>5</x>
					<y>0</y>
					<rows>1</rows>
					<cols>1</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<event type="set">
					<id>decision_exam_office_set</id>
					<actions phase="post">
						<action id="8">
							<![CDATA[
							decide: t.decide,
							decision_exam_office: f.decision_exam_office,
							rejection_reason: f.rejection_reason;

							make rejection_reason, editable on decide when { decision_exam_office.value == "ko" }
							make rejection_reason, hidden on decide when { decision_exam_office.value != "ko" }
							]]>
						</action>
					</actions>
				</event>
			</dataRef>
			<dataRef>
				<id>rejection_reason</id>
				<logic>
					<behavior>hidden</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>3</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<component>
					<name>htmltextarea</name>
				</component>
			</dataRef>
			<dataRef>
				<id>achievement_tasks_owner</id>
				<logic>
					<behavior>editable</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>4</y>
					<rows>1</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>decide_finish</id>
			<actions phase="post">
				<action id="10">
					<![CDATA[
					decision_exam_office: f.decision_exam_office,
					decision: f.decision;

					change decision value { decision_exam_office.value; }
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>init</id>
		<x>592</x>
		<y>176</y>
		<label>Init</label>
		<icon>settings</icon>
		<dataGroup>
			<id>init_0</id>
			<cols>4</cols>
			<layout>grid</layout>
			<dataRef>
				<id>parent</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>modul</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>2</x>
					<y>0</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>achievement_cases</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>2</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>init_finish</id>
			<actions phase="post">
				<action id="2">
					<![CDATA[
					achievement_cases: f.achievement_cases,
					achievement_tasks: f.achievement_tasks;

					def achievement = createCase("achievement")
					def initTask = assignTask("init", achievement)
					setData(initTask, [
							"parent": [
									"value": [useCase.stringId],
									"type": "caseRef"
							]
					])
					finishTask(initTask)

					def achievementTaskId = getTaskId("form", achievement)
					change achievement_tasks value { [achievementTaskId] }
					//make ["remove"],hidden on ([leistungTaskId]) when {true}
					change achievement_cases value { [achievement.stringId] }
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>print</id>
		<x>1168</x>
		<y>176</y>
		<label>Send module application</label>
		<dataGroup>
			<id>print_0</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>title_print</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>5</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>decision</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>5</x>
					<y>0</y>
					<rows>1</rows>
					<cols>1</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>rejection_reason</id>
				<logic>
					<behavior>hidden</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>1</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>achievement_tasks_examiner</id>
				<logic>
