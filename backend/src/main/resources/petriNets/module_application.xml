				</logic>
				<layout>
					<x>0</x>
					<y>2</y>
					<rows>1</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
	</transition>
	<transition>
		<id>review</id>
		<x>848</x>
		<y>176</y>
		<label>Review module application</label>
		<assignPolicy>auto</assignPolicy>
		<dataGroup>
			<id>t3_0</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>title_print</id>
				<logic>
					<behavior>visible</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>0</y>
					<rows>1</rows>
					<cols>4</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
			<dataRef>
				<id>responsible_person</id>
				<logic>
					<behavior>editable</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>4</x>
					<y>0</y>
					<rows>1</rows>
					<cols>1</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<event type="set">
					<id>responsible_person_set</id>
					<actions phase="post">
						<action id="6">
							<![CDATA[
							review: t.review,
							decision_exam_office: f.decision_exam_office,
							responsible_person: f.responsible_person;

							make decision_exam_office, editable on review when { responsible_person.value == "exam" }
							make decision_exam_office, hidden on review when { responsible_person.value == "owner" }
							if (responsible_person.value != "exam") {
								change decision_exam_office value { null }
							}
							]]>
						</action>
					</actions>
				</event>
			</dataRef>
			<dataRef>
				<id>decision_exam_office</id>
				<logic>
					<behavior>hidden</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>5</x>
					<y>0</y>
					<rows>1</rows>
					<cols>1</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<event type="set">
					<id>decision_exam_office_set</id>
					<actions phase="post">
						<action id="5">
							<![CDATA[
							decision_exam_office: f.decision_exam_office,
							review: t.review,
							rejection_reason: f.rejection_reason;

							make rejection_reason, editable on review when { decision_exam_office.value == "ko" }
							make rejection_reason, hidden on review when { decision_exam_office.value != "ko" }
							]]>
						</action>
					</actions>
				</event>
			</dataRef>
			<dataRef>
				<id>rejection_reason</id>
				<logic>
					<behavior>hidden</behavior>
					<behavior>required</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>1</y>
					<rows>3</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
				<component>
					<name>htmltextarea</name>
				</component>
			</dataRef>
			<dataRef>
				<id>achievement_tasks_examiner</id>
				<logic>
					<behavior>editable</behavior>
				</logic>
				<layout>
					<x>0</x>
					<y>4</y>
					<rows>1</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>review_finish</id>
			<actions phase="post">
				<action id="9">
					<![CDATA[
					achievement_tasks_owner: f.achievement_tasks_owner,
					achievement_cases: f.achievement_cases;

					def achievementCases = findCases(achievement_cases)
					def approvedAchievements = []
					achievementCases.each { achievement ->
						if(achievement.dataSet["verification"].value == "ok") {
							approvedAchievements << achievement.stringId
						}
					}
					def printTasks = searchTasks("tasks: transitionId = 'print' and caseId in ${pfql(approvedAchievements)}")
					change achievement_tasks_owner value { printTasks.collect { it.stringId } }
					]]>
				</action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>skip</id>
		<x>1008</x>
		<y>144</y>
		<label>skip</label>
		<icon>settings</icon>
		<event type="finish">
			<id>skip_finish</id>
			<actions phase="post">
				<action id="11">
					<![CDATA[
					decision_exam_office: f.decision_exam_office,
					decision: f.decision;

					change decision value { decision_exam_office.value }
					]]>
				</action>
			</actions>
		</event>
	</transition>
