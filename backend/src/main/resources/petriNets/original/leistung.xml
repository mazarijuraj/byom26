	<data type="button">
		<id>remove</id>
		<title/>
		<placeholder>remove</placeholder>
		<event type="set">
			<id>remove_set</id>
			<actions phase="post">
				<action id="1">
					<![CDATA[
					parent: f.parent;
					def modulantragCase = findCaseElastic("stringId:${parent.value[0]}");
					def formTaskId = getTaskId("form");
					setData("eintragen", modulantragCase, [
					    "leistungen": [
					        "value": modulantragCase.dataSet["leistungen"].value - formTaskId,
					        "type": "taskRef"
					    ],
					    "leistungen_cases": [
					        "value": modulantragCase.dataSet["leistungen_cases"].value - useCase.stringId,
					        "type": "caseRef"
					    ]
					]);
					/*
					async.run{
					    workflowService.deleteCase(useCase)
					}
					*/
					]]>
				</action>
			</actions>
		</event>
	</data>
