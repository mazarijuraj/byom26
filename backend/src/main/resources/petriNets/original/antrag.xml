	<transition>
		<id>t6</id>
		<x>816</x>
		<y>208</y>
		<label>Verteilen</label>
		<icon>settings</icon>
		<trigger type="auto"/>
		<event type="assign">
			<id>t6_assign</id>
			<actions phase="post">
				<action id="7">
					<![CDATA[
					n: f.n,
					modulantraege_cases: f.modulantraege_cases;
					def modulantraegeCases = findCases({it._id.in(modulantraege_cases.value)});
					def antraegeSkipFV = [];
					def antraegeAnFV = [];
					modulantraegeCases.each { modulantrag -> 
					    if (modulantrag.dataSet["enum_verantwortliche"].value == "fv") {
					        antraegeAnFV << modulantrag;
					    } else {
					        antraegeSkipFV << modulantrag
					    }    
					}
					// verteile an FV
					def fachvertraeter = antraegeAnFV.collect { modulantrag ->
					    def modulCase = findCase({it._id.eq(modulantrag.dataSet["modul"].value[0])});
					    return modulCase.dataSet["fachvertraeter"].value.id;
					}
					// groupBy
					def userToAntrag = [:];
					fachvertraeter.eachWithIndex { fvid, i ->
					    if(userToAntrag.containsKey(fvid)) {
					        userToAntrag[fvid] << antraegeAnFV[i].stringId
					    } else {
					        userToAntrag[fvid] = [antraegeAnFV[i].stringId]
					    }
					}
					// Prüfung durch Fachvertreter
					def zeugnisseTaskId = getTaskId("zeugnisse");
					userToAntrag.each { fvid, modulantraegeCaseIds ->
					    def pruefung = createCase("fv_pruefung");
					    def initTask = assignTask("init", pruefung);
					    def taskrefValue = [zeugnisseTaskId]
					    def modulantragTaskIds = findTasks({it.transitionId.eq("entscheiden").and it.caseId.in(modulantraegeCaseIds)}).collect { t -> t.stringId }
					    taskrefValue.addAll(modulantragTaskIds)
					    setData(initTask, [
					        "parent": [
					            "value": [useCase.stringId],
					            "type": "caseRef"
					        ],
					        "fachvertreter": [
					            "value": [fvid],
					            "type": "userList"
					        ],
					        "modulantraege": [
					            "value": taskrefValue,
					            "type": "taskRef"
					        ]
					    ]);
					    finishTask(initTask);
					}
					change n value { userToAntrag.size(); }
					// skip Modulanträge bereits entschieden bei PA
					if (antraegeSkipFV.size() > 0) {
					    def skipCaseIds = antraegeSkipFV.collect{it -> it.stringId}
					    def modulantragTasks = findTasks({it.transitionId.eq("skip").and it.caseId.in(skipCaseIds)})
					    assignTasks(modulantragTasks);
					    finishTasks(modulantragTasks);
					}
					]]>
				</action>
			</actions>
		</event>
	</transition>
