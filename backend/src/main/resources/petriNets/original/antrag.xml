					def studiengangCase = findCaseElastic("stringId:${studiengang.value}");
					def modulIds = studiengangCase.dataSet["modulliste"].value;
					def idQuery = "(" + modulIds.join(" OR ") + ")"
					def modulCases = findCasesElastic("stringId:${idQuery}", org.springframework.data.domain.PageRequest.of(0,200));
					change modulantraege options { modulCases.collectEntries{ modulCase -> [modulCase.stringId, "${modulCase.dataSet["nummer"].value} - ${modulCase.dataSet["name"].value} (${modulCase.dataSet["ects"].value.intValue()} ECTS) - [${modulCase.dataSet["inhalt"].value}]"] } }
					]]>
				</action>
