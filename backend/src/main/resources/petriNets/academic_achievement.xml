		<placeholder>remove</placeholder>
		<event type="set">
			<id>remove_set</id>
			<actions phase="post">
				<action id="1">
					<![CDATA[
					parent: f.parent;

					def moduleAppCase = findCase(parent)
					def formTaskId = getTaskId("form")
					setData("register", moduleAppCase, [
							"achievement_tasks": [
									"value": moduleAppCase.dataSet["achievement_tasks"].value - formTaskId,
									"type": "taskRef"
							],
							"achievement_cases": [
									"value": moduleAppCase.dataSet["achievement_cases"].value - useCase.stringId,
									"type": "caseRef"
							]
					]);
					/*
					async.run{
					    workflowService.deleteCase(useCase)
					}
					*/
					]]>
				</action>
			</actions>
		</event>
