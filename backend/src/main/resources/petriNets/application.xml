		<event type="assign">
			<id>t2_assign</id>
			<actions phase="pre">
				<action id="2">
					<![CDATA[
					modulantraege: f.modulantraege,
					studiengang: f.studiengang;
					def studiengangCase = findCaseElastic("stringId:${studiengang.value}");
					def modulIds = studiengangCase.dataSet["modulliste"].value;
					def idQuery = "(" + modulIds.join(" OR ") + ")"
					def modulCases = findCasesElastic("stringId:${idQuery}", org.springframework.data.domain.PageRequest.of(0,200));
					change modulantraege options { modulCases.collectEntries{ modulCase -> [modulCase.stringId, "${modulCase.dataSet["nummer"].value} - ${modulCase.dataSet["name"].value} (${modulCase.dataSet["ects"].value.intValue()} ECTS) - [${modulCase.dataSet["inhalt"].value}]"] } }
					]]>
				</action>
				<action id="6">
					<![CDATA[
					studiengang: f.studiengang,
					header: f.header;
					change header value { "<h1>Application for Recognition of Examination Achievements in the Program of Study " + (studiengang.options[studiengang.value]) + "</h1><p>Below you will find a list of modules for which recognition is possible in the selected program of study. In this step, first select the modules for which you would like to check whether you can submit suitable achievements. The bullet points listed serve as an orientation. Examination achievements can be recognized provided there is no significant difference to your achievements in terms of the acquired competencies. In the next step, the module descriptions of all selected modules will be displayed, and you can enter your achievements accordingly.</p>"; }
					]]>
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>t2_finish</id>
			<title>Next</title>
			<actions phase="post">
				<action id="3">
					<![CDATA[
					modulantraege_cases: f.modulantraege_cases,
					modulantraege_tasks: f.modulantraege_tasks,
					modulantraege: f.modulantraege;
					def modulantraegeCaseIds = [];
					def datenEintragenTaskIds = [];
					modulantraege.value.each { modulId ->
					    def modulantragCase = createCase("modulantrag");
					    def initTask = assignTask("init", modulantragCase);
					    setData(initTask, [
					        "parent": [
					            "value": [useCase.stringId],
					            "type": "caseRef"
					        ],
					        "modul": [
					            "value": [modulId],
					            "type": "caseRef"
					        ]
					    ]);
					    finishTask(initTask);
					    def eintragenTaskId = getTaskId("eintragen", modulantragCase);
					    modulantraegeCaseIds << modulantragCase.stringId;
					    datenEintragenTaskIds << eintragenTaskId;
					}
					change modulantraege_tasks value { datenEintragenTaskIds; }
					change modulantraege_cases value { modulantraegeCaseIds; }
					]]>
				</action>
			</actions>
		</event>
