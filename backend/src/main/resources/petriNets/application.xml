	<transition>
		<id>t6</id>
		<x>816</x>
		<y>208</y>
		<label>Distribute</label>
		<icon>settings</icon>
		<trigger type="auto"/>
		<event type="assign">
			<id>t6_assign</id>
			<actions phase="post">
				<action id="7">
					<![CDATA[
					n: f.n,
					module_application_cases: f.module_application_cases;

					def moduleAppsSkipOwner = []
					def antraegeAnFV = []

					def modulesCases = findCases(module_application_cases)
					modulesCases.each { moduleApp ->
					    if (moduleApp.dataSet["responsible_person"].value == "owner") {
					        antraegeAnFV << moduleApp
					    } else {
					        moduleAppsSkipOwner << moduleApp
					    }    
					}
					// verteile an FV
					def fachvertraeter = antraegeAnFV.collect { modulantrag ->
					    def modulCase = findCase({it._id.eq(modulantrag.dataSet["modul"].value[0])});
					    return modulCase.dataSet["fachvertraeter"].value.id;
					}
					// groupBy
					def userToAntrag = [:];
					fachvertraeter.eachWithIndex { fvid, i ->
					    if(userToAntrag.containsKey(fvid)) {
					        userToAntrag[fvid] << antraegeAnFV[i].stringId
					    } else {
					        userToAntrag[fvid] = [antraegeAnFV[i].stringId]
					    }
					}
					// Prüfung durch Fachvertreter
					def testimonialsTaskId = getTaskId("testimonials");
					userToAntrag.each { fvid, moduleApplicationCaseIds ->
					    def pruefung = createCase("fv_pruefung");
					    def initTask = assignTask("init", pruefung);
					    def taskrefValue = [testimonialsTaskId]
					    def modulantragTaskIds = findTasks({it.transitionId.eq("entscheiden").and it.caseId.in(moduleApplicationCaseIds)}).collect { t -> t.stringId }
					    taskrefValue.addAll(modulantragTaskIds)
					    setData(initTask, [
					        "parent": [
					            "value": [useCase.stringId],
					            "type": "caseRef"
					        ],
					        "fachvertreter": [
					            "value": [fvid],
					            "type": "userList"
					        ],
					        "modules": [
					            "value": taskrefValue,
					            "type": "taskRef"
					        ]
					    ]);
					    finishTask(initTask);
					}
					change n value { userToAntrag.size(); }
					// skip Modulanträge bereits entschieden bei PA
					if (moduleAppsSkipOwner.size() > 0) {
					    def skipCaseIds = moduleAppsSkipOwner.collect{it -> it.stringId}
					    def modulantragTasks = findTasks({it.transitionId.eq("skip").and it.caseId.in(skipCaseIds)})
					    assignTasks(modulantragTasks);
					    finishTasks(modulantragTasks);
					}
					]]>
				</action>
			</actions>
		</event>
	</transition>
