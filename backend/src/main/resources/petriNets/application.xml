			<actions phase="pre">
				<action id="2">
					<![CDATA[
					header: f.header,
					modules: f.modules,
					study_program: f.study_program;

					def studyProgramCase = searchCase("case: id == '${study_program.value}'")
					List<String> moduleIds = studyProgramCase.dataSet["module_list"].value
					def moduleCases = searchCases("cases: id in ${pfql(moduleIds)}")

					change modules options {
						moduleCases.collectEntries{
							[it.stringId, "${it.dataSet["number"].value} - ${it.dataSet["name"].value} (${it.dataSet["ects"].value.intValue()} ECTS)"]
						}
					}
					change header value { "<h1>Application for Recognition of Examination Achievements in the Program of Study " + (study_program.options[study_program.value]) + "</h1><p>Below you will find a list of modules for which recognition is possible in the selected program of study. In this step, first select the modules for which you would like to check whether you can submit suitable achievements. The bullet points listed serve as an orientation. Examination achievements can be recognized provided there is no significant difference to your achievements in terms of the acquired competencies. In the next step, the module descriptions of all selected modules will be displayed, and you can enter your achievements accordingly.</p>"; }
					]]>
				</action>
			</actions>
		</event>
		<event type="finish">
			<id>t2_finish</id>
			<title>Next</title>
			<actions phase="post">
				<action id="3">
					<![CDATA[
					module_application_cases: f.module_application_cases,
					module_applications_tasks: f.module_applications_tasks,
					modules: f.modules;

					def moduleApplicationCaseIds = []
					def dataTaskIds = []
					modules.value.each { modulId ->
					    def modulAppCase = createCase("module_application")
					    def initTask = assignTask("init", modulAppCase)
					    setData(initTask, [
					        "parent": [
					            "value": [useCase.stringId],
					            "type": "caseRef"
					        ],
