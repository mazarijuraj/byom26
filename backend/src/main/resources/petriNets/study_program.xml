		</allowedNets>
	</data>
	<data type="multichoice_map">
		<id>module_list_multichoice</id>
		<title>Modules</title>
		<component>
			<name>caseref</name>
			<properties>
				<property key="headers">module-number,module-name,module-ects,module-owner</property>
			</properties>
		</component>
		<event type="get">
			<id>module_list_get</id>
			<actions phase="pre">
				<action>
					<![CDATA[
					module_list: f.module_list_multichoice;

					def modules = searchCases("cases: processIdentifier eq 'module'")
					def module_list_options = modules.collectEntries{ module ->
						[(module.stringId): module.title]
					}
					change module_list options { module_list_options }
					]]>
				</action>
			</actions>
		</event>
	</data>
